# Shopy Shop — backend environment variables
# Copy to server/.env for local development. Never commit real secrets.
# In production, set the same names in Vercel → backend project → Environment Variables.

# Express
PORT=3001
# Local: http://localhost:5173
# Production: https://shopy-shop-gamma.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Supplier API — Labb 1
SUPPLIER_API_BASE_URL=https://leverantor-api.vercel.app
SUPPLIER_API_KEY=YOUR_SUPPLIER_API_KEY
SUPPLIER_INDUSTRY=elektronik

# Algolia — Labb 2
ALGOLIA_APP_ID=YOUR_ALGOLIA_APP_ID
ALGOLIA_SEARCH_API_KEY=YOUR_ALGOLIA_SEARCH_API_KEY
ALGOLIA_WRITE_API_KEY=YOUR_ALGOLIA_WRITE_API_KEY
ALGOLIA_INDEX_NAME=products

# Legacy test payment webhook (at least 32 characters)
TEST_PAYMENT_WEBHOOK_SECRET=YOUR_TEST_PAYMENT_WEBHOOK_SECRET

# Stripe Checkout (test mode) — Labb 3
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Shop session (JWT signing secret, at least 32 characters).
# Used for both customer and GitHub admin sessions.
CUSTOMER_SESSION_SECRET=YOUR_LONG_RANDOM_SECRET

# Google OAuth — customer login (Inlämningsuppgift 2, Labb 6)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Local: http://localhost:3001/api/auth/google/callback
# Production: https://shopy-shop-gamma.vercel.app/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub OAuth — admin login
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
# Production: https://shopy-shop-gamma.vercel.app/api/auth/github/callback
GITHUB_CALLBACK_URL=https://YOUR_SHOP.vercel.app/api/auth/github/callback
# Comma-separated GitHub usernames allowed to be admin
ADMIN_GITHUB_LOGINS=your-github-username

# Resend — order confirmation email (Labb 8)
RESEND_API_KEY=re_REPLACE_ME
# Without your own domain: onboarding@resend.dev (can only send to your Resend account email)
EMAIL_FROM=onboarding@resend.dev