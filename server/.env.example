# Shopy Shop — backend environment variables
# Copy to server/.env for local development. Never commit real secrets.

# Express
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://esgudrjzdjnihctfvqie.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Supplier API — Labb 1
SUPPLIER_API_BASE_URL=https://leverantor-api.vercel.app
SUPPLIER_API_KEY=YOUR_SUPPLIER_API_KEY
SUPPLIER_INDUSTRY=elektronik

# Algolia — Labb 2
ALGOLIA_APP_ID=YOUR_ALGOLIA_APP_ID
ALGOLIA_SEARCH_API_KEY=YOUR_ALGOLIA_SEARCH_API_KEY
ALGOLIA_WRITE_API_KEY=YOUR_ALGOLIA_WRITE_API_KEY
ALGOLIA_INDEX_NAME=products

# Legacy test payment webhook
TEST_PAYMENT_WEBHOOK_SECRET=YOUR_TEST_PAYMENT_WEBHOOK_SECRET

# Stripe Checkout (test mode) — Labb 3
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
